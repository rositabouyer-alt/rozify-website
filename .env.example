# ---------------------------------------------------------------------------
# ROZIFY AI - environment example
# Copy to .env and adjust. Never commit real keys.
# ---------------------------------------------------------------------------

# --- Frontend (VITE_* variables are exposed to the browser) ---------------

# Demo mode uses the built-in mock backend (services, availability, bookings).
# Set to "false" once a real backend / CRM is connected.
VITE_DEMO_MODE=true

# Base URL of the real backend. Leave empty in demo mode.
# Example: https://api.example.com
VITE_API_BASE_URL=

# --- Server only (never exposed to the browser) ---------------------------

# AI provider used by /api/chat: demo | ollama | gapgpt
AI_PROVIDER=demo

# Ollama (self-hosted, local models)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# GapGPT (OpenAI-compatible API). The key is read server-side only.
GAPGPT_API_KEY=your_gapgpt_api_key_here
GAPGPT_BASE_URL=https://api.gapgpt.app/v1
GAPGPT_MODEL=gpt-4o-mini

# CRM dashboard connection. Shared token the website uses to send bookings,
# customers and chat leads to your CRM. Server-side only.
WEBSITE_INGEST_TOKEN=

# CRM base URL (your separate CRM project). Leave empty to disable CRM sync â€”
# the website keeps working normally. Example: https://crm.example.com
CRM_API_URL=
# Optional: path of the CRM ingest endpoint (default /api/ingest/website)
CRM_INGEST_PATH=/api/ingest/website
